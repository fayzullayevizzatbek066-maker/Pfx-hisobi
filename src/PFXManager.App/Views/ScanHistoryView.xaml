<UserControl x:Class="PFXManager.App.Views.ScanHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:PFXManager.App.Resources">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Nav_ScanHistory}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{x:Static res:Strings.Refresh}" Command="{Binding LoadCommand}" Padding="10,6" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Sessions}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_StartedAt}" Binding="{Binding StartedAtUtc, StringFormat=dd.MM.yyyy HH:mm}" Width="160" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_FinishedAt}" Binding="{Binding FinishedAtUtc, StringFormat=dd.MM.yyyy HH:mm}" Width="160" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_FilesChecked}" Binding="{Binding FilesChecked}" Width="150" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_PfxFound}" Binding="{Binding PfxFound}" Width="120" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_Expired}" Binding="{Binding ExpiredCount}" Width="120" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_Errors}" Binding="{Binding ErrorCount}" Width="100" />
                <DataGridTextColumn Header="{x:Static res:Strings.ScanHistory_Cancelled}" Binding="{Binding WasCancelled}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
