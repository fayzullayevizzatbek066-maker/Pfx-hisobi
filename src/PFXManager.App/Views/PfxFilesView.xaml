<UserControl x:Class="PFXManager.App.Views.PfxFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:PFXManager.App.Resources"
             xmlns:vm="clr-namespace:PFXManager.App.ViewModels">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Nav_PfxFiles}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static res:Strings.SearchPlaceholder}" Margin="0,0,8,0" />

            <ComboBox Width="200" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Display" Margin="0,0,8,0" />

            <ComboBox Width="140" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Margin="0,0,16,0" />

            <Button Content="{x:Static res:Strings.SelectAllExpired}" Command="{Binding SelectAllExpiredCommand}" Margin="0,0,8,0" Padding="10,6" />
            <Button Content="{x:Static res:Strings.ClearSelection}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" Padding="10,6" />
            <Button Content="{x:Static res:Strings.MoveToQuarantine}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding MoveSelectedToQuarantineCommand}" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.Refresh}" Command="{Binding RefreshCommand}" Padding="10,6" />

            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredRecords}" x:Name="Grid">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Select}" Width="36" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      Checked="SelectionCheckBox_Toggled" Unchecked="SelectionCheckBox_Toggled" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{x:Static res:Strings.Col_Status}" Binding="{Binding StatusBadge}" Width="150" SortMemberPath="Status" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Owner}" Binding="{Binding OwnerDisplay}" Width="180" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Stir}" Binding="{Binding StirDisplay}" Width="120" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Serial}" Binding="{Binding SerialNumber}" Width="130" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Thumbprint}" Binding="{Binding Thumbprint}" Width="160" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_NotBefore}" Binding="{Binding NotBefore, StringFormat=dd.MM.yyyy}" Width="100" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_NotAfter}" Binding="{Binding NotAfter, StringFormat=dd.MM.yyyy}" Width="100" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_RemainingDays}" Binding="{Binding RemainingDays}" Width="90" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_FileName}" Binding="{Binding FileName}" Width="160" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_FilePath}" Binding="{Binding FullPath}" Width="260" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Drive}" Binding="{Binding Drive}" Width="70" />
                <DataGridTextColumn Header="{x:Static res:Strings.Col_Size}" Binding="{Binding SizeDisplay}" Width="90" />
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_PreviewMouseRightButtonDown" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.ShowInExplorer}"
                              Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.CopyPath}"
                              Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static res:Strings.EnterPassword}"
                              Command="{Binding PlacementTarget.DataContext.EnterPasswordCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
