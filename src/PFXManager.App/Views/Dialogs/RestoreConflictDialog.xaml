<Window x:Class="PFXManager.App.Views.Dialogs.RestoreConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Button x:Name="RenameButton" Content="Boshqa nom bilan tiklash" Height="34" Margin="0,0,0,8"
                    HorizontalContentAlignment="Left" Padding="10,0" Click="RenameButton_Click" />
            <Button x:Name="ChooseButton" Content="Manzil tanlash" Height="34" Margin="0,0,0,8"
                    HorizontalContentAlignment="Left" Padding="10,0" Click="ChooseButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Bekor qilish" IsCancel="True" IsDefault="True"
                    Width="120" Height="32" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
