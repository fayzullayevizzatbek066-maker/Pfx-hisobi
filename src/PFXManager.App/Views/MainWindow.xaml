<Window x:Class="PFXManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:PFXManager.App.Resources"
        Title="PFX Manager"
        Height="780" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PFX Manager" FontSize="18" FontWeight="Bold" Margin="16,20,16,16" />

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_Dashboard}" Command="{Binding NavigateDashboardCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_PfxFiles}" Command="{Binding NavigatePfxFilesCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_WindowsCertificates}" Command="{Binding NavigateWindowsCertificatesCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_Duplicates}" Command="{Binding NavigateDuplicatesCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_Quarantine}" Command="{Binding NavigateQuarantineCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_ScanHistory}" Command="{Binding NavigateScanHistoryCommand}" />
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="{x:Static res:Strings.Nav_Settings}" Command="{Binding NavigateSettingsCommand}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12">
                    <Button Content="{x:Static res:Strings.ScanComputer}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40"
                            Command="{Binding StartScanCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Scan progress bar, shown only while scanning -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="16,10" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.Scanning}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScanCurrentDirectory}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{x:Static res:Strings.FilesCheckedLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=": " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ScanFilesChecked}" FontSize="11" Margin="0,0,16,0" />
                            <TextBlock Text="{x:Static res:Strings.PfxFoundLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=": " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ScanPfxFound}" FontSize="11" Margin="0,0,16,0" />
                            <TextBlock Text="{x:Static res:Strings.ErrorsLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=": " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ScanErrorCount}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Cancel}" VerticalAlignment="Top"
                            Width="120" Height="30" Command="{Binding CancelScanCommand}" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" Margin="0" />
        </Grid>
    </Grid>
</Window>
