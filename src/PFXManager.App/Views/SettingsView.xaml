<UserControl x:Class="PFXManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:PFXManager.App.Resources">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.Nav_Settings}" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_ScanLocations}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox Content="{x:Static res:Strings.Settings_LocalFixedDrives}" IsChecked="{Binding ScanLocalFixedDrives}" Margin="0,4" />
                    <CheckBox Content="{x:Static res:Strings.Settings_NetworkDrives}" IsChecked="{Binding ScanNetworkDrives}" Margin="0,4" />
                    <CheckBox Content="{x:Static res:Strings.Settings_RemovableDrives}" IsChecked="{Binding ScanRemovableDrives}" Margin="0,4" />

                    <TextBlock Text="{x:Static res:Strings.Settings_CustomFolders}" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <ListBox ItemsSource="{Binding CustomFolders}" SelectedItem="{Binding SelectedCustomFolder}" Height="100" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.Settings_AddFolder}" Command="{Binding AddCustomFolderCommand}" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="{x:Static res:Strings.Settings_RemoveFolder}" Command="{Binding RemoveCustomFolderCommand}" Padding="10,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Expiration}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="30 kun ichida ogohlantirish:" VerticalAlignment="Center" Width="220" />
                        <TextBox Text="{Binding ExpiringSoonWarningDays}" Width="60" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="90 kun ichida ogohlantirish:" VerticalAlignment="Center" Width="220" />
                        <TextBox Text="{Binding ExpiringWarningDays}" Width="60" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_QuarantinePath}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding QuarantinePath}" Width="400" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Content="..." Command="{Binding PickQuarantinePathCommand}" Width="40" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Appearance}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Button Content="{x:Static res:Strings.Settings_Save}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" Width="140" Height="36" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
